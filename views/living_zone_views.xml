<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zoo_living_zone_search" model="ir.ui.view">
        <field name="name">zoo.living.zone.search</field>
        <field name="model">zoo.living.zone</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="zookeeper_id"/>
                <group expand="0" string="Group By">
                    <filter string="Zookeeper" name="group_by_zookeeper" context="{'group_by':'zookeeper_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_zoo_living_zone_kanban" model="ir.ui.view">
        <field name="name">zoo.living.zone.kanban</field>
        <field name="model">zoo.living.zone</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="zookeeper_id"/>
                <field name="animal_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <ul>
                                    <li>Keeper: <field name="zookeeper_id"/>
                                    </li>
                                    <li>Animals: <field name="animal_count"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_zoo_living_zone_tree" model="ir.ui.view">
        <field name="name">zoo.living.zone.tree</field>
        <field name="model">zoo.living.zone</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="zookeeper_id"/>
                <field name="animal_count"/>
            </tree>
        </field>
    </record>

    <record id="view_zoo_living_zone_form" model="ir.ui.view">
        <field name="name">zoo.living.zone.form</field>
        <field name="model">zoo.living.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_animals" type="object" class="oe_stat_button" icon="fa-paw">
                            <field name="animal_count" widget="statinfo" string="Animals"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Zone Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="zookeeper_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Animals" name="animals">
                            <field name="animal_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="species"/>
                                    <field name="age"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_zoo_living_zone" model="ir.actions.act_window">
        <field name="name">Living Zones</field>
        <field name="res_model">zoo.living.zone</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_zoo_living_zone_search"/>
    </record>

    <menuitem id="menu_zoo_living_zone" name="Living Zones" parent="menu_zoo_management" action="action_zoo_living_zone" sequence="20"/>
</odoo>
