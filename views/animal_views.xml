<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zoo_animal_search" model="ir.ui.view">
        <field name="name">zoo.animal.search</field>
        <field name="model">zoo.animal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="species"/>
                <field name="gender"/>
                <field name="group_id"/>
                <field name="zone_id"/>
                <filter string="Alive Animals" name="alive" domain="[('state', 'in', ['alive', 'sick'])]"/>
                <filter string="Adults (Age > 2)" name="adult" domain="[('age', '&gt;', 2)]"/>
                <separator/>
                <filter string="Deceased" name="deceased" domain="[('state', '=', 'deceased')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by':'state'}"/>
                    <filter string="Species" name="group_by_species" context="{'group_by':'species'}"/>
                    <filter string="Gender" name="group_by_gender" context="{'group_by':'gender'}"/>
                    <filter string="Animal Group" name="group_by_group" context="{'group_by':'group_id'}"/>
                    <filter string="Zone" name="group_by_zone" context="{'group_by':'zone_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_zoo_animal_kanban" model="ir.ui.view">
        <field name="name">zoo.animal.kanban</field>
        <field name="model">zoo.animal</field>
        <field name="arch" type="xml">
            <kanban default_group_by="group_id">
                <field name="id"/>
                <field name="name"/>
                <field name="species"/>
                <field name="group_id"/>
                <field name="picture"/>
                <field name="zone_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image" t-if="record.picture.raw_value">
                                <img t-att-src="kanban_image('zoo.animal', 'picture', record.id.raw_value)" alt="Animal"/>
                            </div>
                            <div class="o_kanban_image" t-else="">
                                <img t-att-src="_s + '/base/static/img/avatar.png'" alt="Animal"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/> (<field name="species"/>)</strong>
                                <ul>
                                    <li>Group: <field name="group_id"/></li>
                                    <li>Gender: <field name="gender"/></li>
                                    <li>Age: <field name="age"/></li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_zoo_animal_tree" model="ir.ui.view">
        <field name="name">zoo.animal.tree</field>
        <field name="model">zoo.animal</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="species"/>
                <field name="gender"/>
                <field name="group_id"/>
                <field name="zone_id"/>
                <field name="age"/>
            </tree>
        </field>
    </record>

    <record id="view_zoo_animal_form" model="ir.ui.view">
        <field name="name">zoo.animal.form</field>
        <field name="model">zoo.animal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Deceased" bg_color="text-bg-danger" invisible="state != 'deceased'"/>
                    <field name="picture" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Animal Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="species"/>
                            <field name="gender"/>
                            <field name="group_id"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="zone_id"/>
                            <field name="next_health_check"/>
                            <field name="health_check_status" invisible="not next_health_check" widget="badge" 
                                   decoration-danger="health_check_status == 'overdue'" 
                                   decoration-warning="health_check_status == 'upcoming'" 
                                   decoration-success="health_check_status == 'ok'"/>
                        </group>
                    </group>
                    <group invisible="state != 'deceased'">
                        <field name="death_date" required="state == 'deceased'"/>
                        <field name="death_reason"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_zoo_animal" model="ir.actions.act_window">
        <field name="name">Animals</field>
        <field name="res_model">zoo.animal</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_zoo_animal_search"/>
    </record>

    <!-- Health Check Specific Tree View -->
    <record id="view_zoo_health_check_tree" model="ir.ui.view">
        <field name="name">zoo.health.check.tree</field>
        <field name="model">zoo.animal</field>
        <field name="arch" type="xml">
            <tree decoration-danger="health_check_status == 'overdue'" 
                  decoration-warning="health_check_status == 'upcoming'" 
                  decoration-success="health_check_status == 'ok'"
                  default_order="next_health_check asc"
                  create="0">
                <field name="name"/>
                <field name="species"/>
                <field name="zone_id"/>
                <field name="next_health_check"/>
                <field name="health_check_status" widget="badge" 
                       decoration-danger="health_check_status == 'overdue'" 
                       decoration-warning="health_check_status == 'upcoming'" 
                       decoration-success="health_check_status == 'ok'"/>
            </tree>
        </field>
    </record>

    <record id="action_zoo_health_check" model="ir.actions.act_window">
        <field name="name">Health Check Schedule</field>
        <field name="res_model">zoo.animal</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_zoo_health_check_tree"/>
        <field name="domain">[('state', 'in', ['alive', 'sick']), ('next_health_check', '!=', False)]</field>
    </record>

    <menuitem id="menu_zoo_health_check"
              name="Health Checks"
              parent="menu_zoo_management"
              action="action_zoo_health_check"
              sequence="15"/>

    <menuitem id="menu_zoo_animal"
              name="Animals"
              parent="menu_zoo_management"
              action="action_zoo_animal"
              sequence="10"/>
</odoo>
